<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Samples_Dev/com.karapak.konnect/Steam/UI/Debug%20Styles.uss?fileID=7433441132597879392&amp;guid=2935767e87cec9241aff67b06048c99c&amp;type=3#Debug Styles"/>
    <ui:VisualElement name="root" style="flex-grow: 1; justify-content: center; align-items: center; color: rgb(255, 255, 255); -unity-text-align: upper-center; -unity-font-style: normal; margin-top: 2.5%; margin-right: 2.5%; margin-bottom: 2.5%; margin-left: 2.5%;">
        <Karapak.Kommon.UitkWindow name="window" clamp-to-parent="false" style="background-color: rgba(32, 32, 32, 0.58); width: 500px; height: 500px; position: absolute;">
            <ui:TabView name="" class="block">
                <ui:Tab label="Host" name="host-lobby" class="block" style="padding-top: 16px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px; flex-grow: 1; bottom: 0; top: 0; flex-shrink: 0; height: 100%;">
                    <ui:Foldout text="General" name="host-lobby__general">
                        <ui:TextField label="Lobby Name" placeholder-text="filler text" name="host-lobby__name"/>
                        <ui:IntegerField label="Player Capacity" name="host-lobby__capacity" value="2"/>
                    </ui:Foldout>
                    <ui:Foldout text="Protection" name="host-lobby__protection" value="false" enabled="true">
                        <ui:TextField label="Password" placeholder-text="password" hide-placeholder-on-focus="true" name="host-lobby__password"/>
                        <ui:EnumField label="Access" value="FriendsOnly" type="Karapak.Konnect.Steam.SteamLobbyAccess, Karapak.Konnect.Steam" name="host-lobby__visibility"/>
                    </ui:Foldout>
                    <ui:Foldout text="Game Settings" name="host-lobby__game" value="false" enabled="false"/>
                    <ui:Button text="Go!" name="host-lobby__submit"/>
                </ui:Tab>
                <ui:Tab label="Join" name="join-lobby" class="block" style="padding-top: 16px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px;">
                    <ui:TabView name="join__parent" class="block" style="background-color: rgba(34, 34, 34, 0.278);">
                        <ui:Tab label="Public" name="join-lobby__public" class="block">
                            <ui:MultiColumnListView columns="" sort-column-descriptions=""/>
                        </ui:Tab>
                        <ui:Tab label="Friends" name="join-lobby__friends" class="block">
                            <ui:MultiColumnListView columns="" sort-column-descriptions=""/>
                        </ui:Tab>
                        <ui:Tab label="Invites" name="join-lobby__invites" class="block">
                            <ui:MultiColumnListView columns="" sort-column-descriptions=""/>
                        </ui:Tab>
                    </ui:TabView>
                    <ui:VisualElement style="flex-grow: 0; flex-direction: row; padding-top: 16px; justify-content: space-between;">
                        <ui:TextField placeholder-text="password" hide-placeholder-on-focus="true" name="join-lobby__password" style="flex-grow: 0.5;"/>
                        <ui:Button text="Join" name="join-lobby__join"/>
                    </ui:VisualElement>
                </ui:Tab>
                <ui:Tab label="Session" name="session" class="block" style="padding-top: 16px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px; flex-grow: 0; height: 100%;">
                    <ui:ScrollView name="" style="flex-grow: 1;">
                        <ui:Label name="session__info" text="Network manager is not available." style="white-space: normal; -unity-text-align: upper-left;"/>
                    </ui:ScrollView>
                    <ui:Button text="Disconnect" name="session__leave"/>
                </ui:Tab>
            </ui:TabView>
        </Karapak.Kommon.UitkWindow>
        <ui:VisualElement style="flex-grow: 1;"/>
        <ui:MultiColumnListView columns="" sort-column-descriptions=""/>
    </ui:VisualElement>
</ui:UXML>
